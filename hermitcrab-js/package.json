{
  "name": "hermitcrab",
  "version": "0.1.0",
  "description": "A rule-based morphological and phonological parser for natural language processing - JavaScript/Node.js implementation",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "lint": "eslint src test",
    "format": "prettier --write 'src/**/*.js' 'test/**/*.js'"
  },
  "keywords": [
    "morphology",
    "phonology",
    "nlp",
    "linguistics",
    "parser",
    "morphological-analysis",
    "hermitcrab"
  ],
  "author": "SIL International",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  }
}
